{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emulator-overlay-engine.local/schemas/mapping.schema.json",
  "title": "Emulator Overlay Engine Mapping Project",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "source",
    "target"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/contractDescriptor" },
    "target": { "$ref": "#/$defs/contractDescriptor" },
    "fieldMappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldMapping" }
    },
    "valueMappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/valueMapping" }
    },
    "calculatedFields": {
      "type": "array",
      "items": { "$ref": "#/$defs/calculatedField" }
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$"
    },
    "jsonPointer": {
      "type": "string",
      "description": "RFC 6901 JSON Pointer. An empty string addresses the root value.",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "contractDescriptor": {
      "type": "object",
      "required": ["id", "type", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "fieldMapping": {
      "type": "object",
      "required": ["sourcePath", "targetPath"],
      "properties": {
        "sourcePath": { "$ref": "#/$defs/jsonPointer" },
        "targetPath": { "$ref": "#/$defs/jsonPointer" },
        "required": { "type": "boolean", "default": false },
        "default": {},
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "valueMappingEntry": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": ["string", "number", "boolean", "null"] },
        "to": {}
      },
      "additionalProperties": false
    },
    "valueMapping": {
      "type": "object",
      "required": ["sourcePath", "targetPath", "entries"],
      "properties": {
        "sourcePath": { "$ref": "#/$defs/jsonPointer" },
        "targetPath": { "$ref": "#/$defs/jsonPointer" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/valueMappingEntry" }
        },
        "unmatched": {
          "enum": ["omit", "passthrough", "error"],
          "default": "error"
        },
        "default": {},
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "calculatedField": {
      "type": "object",
      "required": ["targetPath", "expression"],
      "properties": {
        "targetPath": { "$ref": "#/$defs/jsonPointer" },
        "expression": { "$ref": "#/$defs/expression" },
        "required": { "type": "boolean", "default": false },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "requiredSourcePaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonPointer" },
          "uniqueItems": true
        },
        "requiredTargetPaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonPointer" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        { "$ref": "#/$defs/literalExpression" },
        { "$ref": "#/$defs/fieldExpression" },
        { "$ref": "#/$defs/arrayExpression" },
        { "$ref": "#/$defs/compactExpression" },
        { "$ref": "#/$defs/arithmeticExpression" },
        { "$ref": "#/$defs/comparisonExpression" },
        { "$ref": "#/$defs/booleanExpression" },
        { "$ref": "#/$defs/notExpression" },
        { "$ref": "#/$defs/ifExpression" },
        { "$ref": "#/$defs/coalesceExpression" },
        { "$ref": "#/$defs/defaultExpression" }
      ]
    },
    "literalExpression": {
      "type": "object",
      "required": ["op", "value"],
      "properties": {
        "op": { "const": "literal" },
        "value": {}
      },
      "additionalProperties": false
    },
    "fieldExpression": {
      "type": "object",
      "required": ["op", "path"],
      "properties": {
        "op": { "const": "field" },
        "root": {
          "enum": ["source", "target", "context"],
          "default": "source"
        },
        "path": { "$ref": "#/$defs/jsonPointer" }
      },
      "additionalProperties": false
    },
    "arrayExpression": {
      "type": "object",
      "required": ["op", "items"],
      "properties": {
        "op": { "const": "array" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/expression" }
        }
      },
      "additionalProperties": false
    },
    "compactExpression": {
      "type": "object",
      "required": ["op", "value"],
      "properties": {
        "op": { "const": "compact" },
        "value": { "$ref": "#/$defs/expression" }
      },
      "additionalProperties": false
    },
    "arithmeticExpression": {
      "type": "object",
      "required": ["op", "args"],
      "properties": {
        "op": {
          "enum": ["add", "subtract", "multiply", "divide", "modulo"]
        },
        "args": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/expression" }
        }
      },
      "additionalProperties": false
    },
    "comparisonExpression": {
      "type": "object",
      "required": ["op", "left", "right"],
      "properties": {
        "op": {
          "enum": [
            "equal",
            "notEqual",
            "greaterThan",
            "greaterThanOrEqual",
            "lessThan",
            "lessThanOrEqual"
          ]
        },
        "left": { "$ref": "#/$defs/expression" },
        "right": { "$ref": "#/$defs/expression" }
      },
      "additionalProperties": false
    },
    "booleanExpression": {
      "type": "object",
      "required": ["op", "args"],
      "properties": {
        "op": { "enum": ["and", "or"] },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expression" }
        }
      },
      "additionalProperties": false
    },
    "notExpression": {
      "type": "object",
      "required": ["op", "value"],
      "properties": {
        "op": { "const": "not" },
        "value": { "$ref": "#/$defs/expression" }
      },
      "additionalProperties": false
    },
    "ifExpression": {
      "type": "object",
      "required": ["op", "condition", "then", "else"],
      "properties": {
        "op": { "const": "if" },
        "condition": { "$ref": "#/$defs/expression" },
        "then": { "$ref": "#/$defs/expression" },
        "else": { "$ref": "#/$defs/expression" }
      },
      "additionalProperties": false
    },
    "coalesceExpression": {
      "type": "object",
      "required": ["op", "args"],
      "properties": {
        "op": { "const": "coalesce" },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expression" }
        }
      },
      "additionalProperties": false
    },
    "defaultExpression": {
      "type": "object",
      "required": ["op", "value", "fallback"],
      "properties": {
        "op": { "const": "default" },
        "value": { "$ref": "#/$defs/expression" },
        "fallback": { "$ref": "#/$defs/expression" }
      },
      "additionalProperties": false
    }
  }
}
