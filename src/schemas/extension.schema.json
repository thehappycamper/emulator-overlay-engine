{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emulator-overlay-engine.local/schemas/extension.schema.json",
  "title": "Emulator Overlay Engine Extension Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "type", "version", "description"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
    },
    "name": { "type": "string" },
    "type": { "$ref": "#/$defs/extensionType" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "entrypoints": {
      "type": "object",
      "properties": {
        "docs": { "type": "string" },
        "main": { "type": "string" },
        "schema": { "type": "string" },
        "fixtures": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "generations": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "emulators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "versions": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "games": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "romIds": {
                "type": "array",
                "items": { "type": "string" }
              },
              "versions": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": {
        "type": ["boolean", "string", "array", "object", "number"]
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "array", "object"]
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "array", "object"]
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/uiSlotId" }
        },
        "requiresStateFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "optionalStateFields": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "publicSafety": {
      "type": "object",
      "properties": {
        "containsRoms": { "type": "boolean" },
        "containsBios": { "type": "boolean" },
        "containsSaves": { "type": "boolean" },
        "containsSecrets": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "extensionType": {
      "type": "string",
      "enum": [
        "emulator",
        "game",
        "data",
        "mechanics",
        "calculator",
        "ruleset",
        "analysis",
        "overlay-panel",
        "transport"
      ]
    },
    "uiSlotId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    }
  },
  "additionalProperties": true
}
