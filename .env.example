# Copy this file to .env for local development.
# Do not commit .env. Keep local paths, saves, ROM locations, and private machine details there.
# The Emerald Proof 1 launcher uses the focused .env.local.example template instead.

# Local overlay server port.
PORT=5173

# Validated normalized-state output consumed by the live overlay.
EOE_LIVE_STATE_PATH=public/live-state.json

# Optional local emulator/script references for your machine.
# Use absolute paths in .env only, never in committed docs or source.
EOE_MGBA_EXE=
EOE_MGBA_SCRIPTS_DIR=
# mGBA must inherit this as a process environment variable; it does not load .env.
EMERALD_SOURCE_SNAPSHOT_PATH=
# Poll interval for source-to-normalized-state mapping.
EMERALD_MAPPING_POLL_INTERVAL_MS=250
EOE_VBA_RR_EXE=
EOE_SAVE_DIR=

# Optional domain/game target metadata.
EOE_DEFAULT_DOMAIN=pokemon
EOE_DEFAULT_GENERATION=3
EOE_DEFAULT_GAME=
EOE_DEFAULT_ROM_ID=
