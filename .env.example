# Copy this file to .env for local development.
# Do not commit .env. Keep local paths, saves, ROM locations, and private machine details there.

# Local overlay server port.
PORT=5173

# Optional live state feed path for adapter output.
# Defaults can remain sample-driven until live adapters are implemented.
POE_LIVE_STATE_PATH=public/live-state.json

# Optional local emulator/script references for your machine.
# Use absolute paths in .env only, never in committed docs or source.
POE_MGBA_EXE=
POE_MGBA_SCRIPTS_DIR=
POE_VBA_RR_EXE=
POE_SAVE_DIR=

# Optional adapter target metadata.
POE_DEFAULT_GENERATION=3
POE_DEFAULT_GAME=
POE_DEFAULT_ROM_ID=
