# Copy this file to .env.local and replace the fake paths with local values.
# Never commit .env.local, ROMs, save data, savestates, BIOS files, or credentials.

EOE_MGBA_EXE=C:\path\to\mGBA.exe
EOE_EMERALD_ROM=C:\path\to\Pokemon Emerald (USA, Europe).gba
# Optional. The launcher validates this path but leaves loading it to mGBA's UI.
EOE_EMERALD_SAVESTATE=

# Relative paths resolve from the repository root. Absolute local paths also work.
EMERALD_SOURCE_SNAPSHOT_PATH=var\snapshots\emerald-us-rev0.source.json
EOE_LIVE_STATE_PATH=public\live-state.json

# Optional local tuning.
EMERALD_MAPPING_POLL_INTERVAL_MS=250
PORT=5173
