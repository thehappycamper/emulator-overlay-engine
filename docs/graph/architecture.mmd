flowchart LR
  Sources["Game / Emulator /\nExternal Source"] --> Adapters["Adapters\nfuture live implementations"]
  Adapters --> SourceContract["Source Contract"]
  MappingProject["Declarative Mapping\nSafe JSON AST"] --> MappingRuntime["Mapping Runtime"]
  SourceContract --> MappingRuntime
  MappingRuntime --> NormalizedState["Normalized State"]
  NormalizedState --> CurrentConsumers["Current MVP\nCalculations + Overlay"]

  NormalizedState -. future .-> EventDetection["Domain Event Detection\nFuture"]
  EventDetection -.-> NormalizedEvents["Normalized Events\nFuture"]
  NormalizedEvents -.-> EventConsumers["Rules / Analysis /\nSubscriptions\nFuture"]
  EventConsumers -.-> Actions["Actions / Providers\nFuture"]
  Actions -.-> Experiences["Overlays / Automations /\nSessions\nFuture"]

  NormalizedEvents -. optional derived telemetry .-> Cloud["EOE Cloud\nOptional Future Consumer"]
  Cloud -.-> Experiences

  classDef current fill:#e8f5e9,stroke:#2e7d32,color:#111
  classDef future fill:#fafafa,stroke:#777,stroke-dasharray:5 5,color:#333
  classDef external fill:#f5f5f5,stroke:#555,color:#111
