# Copy this file to .env.local and fill in local paths.
# .env.local is gitignored - never commit it, cores, ROMs, saves, or savestates.
#
# LIBRETRO_CORE_PATH: absolute path to a locally obtained mGBA libretro core
# (mgba_libretro.dll on Windows). The official prebuilt core is redistributed
# by the libretro project itself (MPL-2.0, no game content) via
# https://buildbot.libretro.com/nightly/windows/x86_64/latest/mgba_libretro.dll.zip
LIBRETRO_CORE_PATH=C:\path\to\mgba_libretro.dll

# EMERALD_ROM_PATH: absolute path to a legally obtained English retail
# Pokemon Emerald Rev 0 ROM (same fingerprint as adapters/gen3-mgba: game
# code AGB-BPEE, CRC32 1F1C08FB).
EMERALD_ROM_PATH=C:\path\to\Pokemon Emerald (USA, Europe).gba
