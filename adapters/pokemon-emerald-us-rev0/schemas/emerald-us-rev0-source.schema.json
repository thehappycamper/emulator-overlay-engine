{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:source-contract:pokemon.emerald.us-rev0.acquisition:1.0.0",
  "title": "Pokemon Emerald US Rev 0 Acquisition Source Snapshot",
  "type": "object",
  "required": ["contract", "source", "game", "party", "battle", "location", "badges", "bag"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "pokemon.emerald.us-rev0.acquisition" },
        "version": { "const": "1.0.0" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["provider", "integration", "memory"],
      "properties": {
        "provider": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "integration": { "type": "string", "minLength": 1 },
        "memory": {
          "type": "object",
          "required": ["addressSpace", "primaryDomain", "verifiedDomains"],
          "properties": {
            "addressSpace": { "const": "gba-system-bus" },
            "primaryDomain": { "type": "string", "minLength": 1 },
            "verifiedDomains": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "game": {
      "type": "object",
      "required": ["gameCode", "title", "revision", "crc32"],
      "properties": {
        "gameCode": { "const": "AGB-BPEE" },
        "title": { "const": "POKEMON EMER" },
        "revision": { "const": 0 },
        "crc32": { "const": "1F1C08FB" }
      },
      "additionalProperties": false
    },
    "party": {
      "type": "object",
      "required": ["count", "slots", "first"],
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 6 },
        "slots": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/sourcePokemon" }
        },
        "first": {
          "oneOf": [
            { "$ref": "#/$defs/sourcePokemon" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "count": { "const": 0 } }, "required": ["count"] },
          "then": { "properties": { "first": { "type": "null" } } },
          "else": { "properties": { "first": { "$ref": "#/$defs/sourcePokemon" } } }
        }
      ],
      "additionalProperties": false
    },
    "battle": {
      "type": "object",
      "required": ["active", "typeFlags", "opponent", "trainerBattle"],
      "properties": {
        "active": { "type": "boolean" },
        "typeFlags": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "trainerBattle": { "type": "boolean" },
        "opponent": {
          "oneOf": [
            { "$ref": "#/$defs/sourcePokemon" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "active": { "const": true } }, "required": ["active"] },
          "then": { "properties": { "opponent": { "$ref": "#/$defs/sourcePokemon" } } },
          "else": { "properties": { "opponent": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "location": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mapGroup", "mapNumber", "x", "y"],
          "properties": {
            "mapGroup": { "type": "integer", "minimum": 0, "maximum": 255 },
            "mapNumber": { "type": "integer", "minimum": 0, "maximum": 255 },
            "name": { "type": ["string", "null"] },
            "x": { "type": "integer", "minimum": -32768, "maximum": 32767 },
            "y": { "type": "integer", "minimum": -32768, "maximum": 32767 },
            "encounters": {
              "oneOf": [
                { "type": "array", "items": { "$ref": "#/$defs/sourceEncounter" } },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "badges": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "type": "boolean" }
        },
        { "type": "null" }
      ]
    },
    "bag": {
      "oneOf": [
        {
          "type": "object",
          "required": ["balls"],
          "properties": {
            "balls": {
              "type": "array",
              "items": { "$ref": "#/$defs/sourceBallSlot" }
            }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "sourcePokemon": {
      "type": "object",
      "required": ["speciesId", "level", "currentHp", "maxHp"],
      "properties": {
        "speciesId": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "name": { "type": ["string", "null"] },
        "nickname": { "type": "string" },
        "types": {
          "oneOf": [
            { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "gender": { "enum": ["male", "female", "genderless", null] },
        "level": { "type": "integer", "minimum": 0, "maximum": 255 },
        "currentHp": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "maxHp": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "status": { "type": "string" },
        "item": { "type": ["string", "null"] },
        "itemId": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
        "exp": { "type": "integer", "minimum": 0 },
        "expProgress": {
          "oneOf": [
            {
              "type": "object",
              "required": ["expIntoLevel", "expForNextLevel", "percent"],
              "properties": {
                "expIntoLevel": { "type": "integer", "minimum": 0 },
                "expForNextLevel": { "type": "integer", "minimum": 0 },
                "percent": { "type": "number", "minimum": 0, "maximum": 100 }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "stats": { "$ref": "#/$defs/sourceStats" },
        "ivs": { "$ref": "#/$defs/sourceStats" },
        "catchRate": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "moves": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/sourceMove" }
        }
      },
      "additionalProperties": false
    },
    "sourceEncounter": {
      "type": "object",
      "required": ["method", "speciesId", "minLevel", "maxLevel", "rate"],
      "properties": {
        "method": { "type": "string" },
        "speciesId": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": ["string", "null"] },
        "minLevel": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxLevel": { "type": "integer", "minimum": 1, "maximum": 100 },
        "rate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "sourceBallSlot": {
      "type": "object",
      "required": ["id", "quantity"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": ["string", "null"] },
        "quantity": { "type": "integer", "minimum": 0, "maximum": 999 },
        "catchChance": {
          "description": "Computed catch probability [0,1] against the current wild opponent, or null when not in a wild battle or when this ball's real bonus depends on undecoded state.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "sourceStats": {
      "type": "object",
      "properties": {
        "hp": { "type": "integer", "minimum": 0 },
        "atk": { "type": "integer", "minimum": 0 },
        "def": { "type": "integer", "minimum": 0 },
        "spa": { "type": "integer", "minimum": 0 },
        "spd": { "type": "integer", "minimum": 0 },
        "spe": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sourceMove": {
      "type": "object",
      "required": ["id", "currentPp"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": ["string", "null"] },
        "type": { "type": ["string", "null"] },
        "category": { "enum": ["physical", "special", "status", null] },
        "power": { "type": ["integer", "null"], "minimum": 0 },
        "accuracy": { "type": ["integer", "null"], "minimum": 0 },
        "currentPp": { "type": "integer", "minimum": 0, "maximum": 255 },
        "maxPp": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
