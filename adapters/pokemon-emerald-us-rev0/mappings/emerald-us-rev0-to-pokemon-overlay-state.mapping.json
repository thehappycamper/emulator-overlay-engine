{
  "schemaVersion": "0.1.0",
  "id": "pokemon.emerald.us-rev0-to-overlay-state",
  "name": "Pokemon Emerald US Rev 0 To Pokemon Overlay State",
  "version": "2.2.0",
  "description": "Maps the provider-neutral, already-enriched Emerald acquisition snapshot (full party, opponent, badges, resolved location name) into the current Pokemon normalized overlay state. Unlike the prior fixed-single-slot mapping this supersedes, no synthetic placeholder Pokemon data is used: party members and the opponent are included only when the source genuinely reports them. P05-T011 additionally maps Poke Ball inventory, per-map wild encounter rates, trainer-battle detection, and per-Pokemon base catch rate.",
  "source": {
    "id": "pokemon.emerald.us-rev0.acquisition",
    "type": "acquisition-source-snapshot",
    "version": "1.0.0",
    "schema": "urn:source-contract:pokemon.emerald.us-rev0.acquisition:1.0.0",
    "description": "Enriched (species/type/move/item/location names already resolved) live values acquired from Pokemon Emerald US Rev 0 through a supported provider."
  },
  "target": {
    "id": "pokemon.overlay-state",
    "type": "normalized-state",
    "version": "0.1.0",
    "schema": "https://emulator-overlay-engine.local/schemas/overlay-state.schema.json",
    "description": "Pokemon-owned normalized state consumed by the current overlay presentation."
  },
  "fieldMappings": [
    {
      "sourcePath": "/__placeholder/schemaVersion",
      "targetPath": "/schemaVersion",
      "default": "0.1.0",
      "description": "Literal target contract version; not acquired from the game."
    },
    {
      "sourcePath": "/__placeholder/generation",
      "targetPath": "/game/generation",
      "default": 3,
      "description": "Literal generation for the supported Emerald game configuration."
    },
    {
      "sourcePath": "/game/title",
      "targetPath": "/game/title",
      "required": true
    },
    {
      "sourcePath": "/source/provider/name",
      "targetPath": "/game/adapter",
      "required": true,
      "description": "Provider provenance label for display and diagnostics."
    },
    {
      "sourcePath": "/game/gameCode",
      "targetPath": "/game/romId",
      "required": true
    },
    {
      "sourcePath": "/__placeholder/activePlayerIndex",
      "targetPath": "/battle/activePlayerIndex",
      "default": 0,
      "description": "Literal fixed player slot; active-slot tracking is not implemented."
    },
    {
      "sourcePath": "/__placeholder/bag",
      "targetPath": "/bag",
      "default": {},
      "description": "Ensures /bag always exists even when no ball data is available; /bag/balls is populated separately below when the save block is readable."
    },
    {
      "sourcePath": "/__placeholder/party",
      "targetPath": "/player/party",
      "default": [],
      "description": "Ensures an empty party still produces a valid (empty-array) target even though no per-slot mapping ever fires."
    },
    {
      "sourcePath": "/location/name",
      "targetPath": "/location/name",
      "default": "Unknown location",
      "description": "Resolved by the acquisition layer from map group/number. Falls back to a literal, honestly-labeled default (not a fake place name) when the save block region, or that specific lookup, is unavailable."
    },
    {
      "sourcePath": "/location/mapGroup",
      "targetPath": "/extensions/pokemon.emerald.us-rev0.acquisition/location/mapGroup"
    },
    {
      "sourcePath": "/location/mapNumber",
      "targetPath": "/extensions/pokemon.emerald.us-rev0.acquisition/location/mapNumber"
