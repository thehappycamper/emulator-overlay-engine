{
  "schemaVersion": "0.1.0",
  "id": "example.fusion-species-mapping",
  "name": "Example Fusion Mapping",
  "version": "0.1.0",
  "description": "Maps one synthetic fusion-species table row into a normalized domain record.",
  "source": {
    "id": "example.fusion-species-table-row",
    "type": "table-row",
    "version": "1.0.0",
    "description": "Synthetic example data for mapping a fused species table."
  },
  "target": {
    "id": "example.pokemon.fusion-species-record",
    "type": "domain-record",
    "version": "0.1.0",
    "description": "Example normalized fusion-species record consumed by a domain extension."
  },
  "fieldMappings": [
    {
      "sourcePath": "/fusion_id",
      "targetPath": "/speciesId",
      "required": true
    },
    {
      "sourcePath": "/fusion_name",
      "targetPath": "/display/name",
      "required": true
    },
    {
      "sourcePath": "/head_id",
      "targetPath": "/components/0/speciesId",
      "required": true
    },
    {
      "sourcePath": "/body_id",
      "targetPath": "/components/1/speciesId",
      "required": true
    }
  ],
  "calculatedFields": [
    {
      "targetPath": "/name",
      "expression": {
        "op": "field",
        "root": "target",
        "path": "/display/name"
      },
      "required": true
    },
    {
      "targetPath": "/types",
      "expression": {
        "op": "compact",
        "value": {
          "op": "array",
          "items": [
            { "op": "field", "path": "/primary_type" },
            { "op": "field", "path": "/secondary_type" }
          ]
        }
      },
      "required": true
    }
  ],
  "validation": {
    "requiredSourcePaths": ["/fusion_id", "/fusion_name", "/head_id", "/body_id"],
    "requiredTargetPaths": ["/speciesId", "/name", "/types", "/components/0/speciesId", "/components/1/speciesId"]
  }
}
