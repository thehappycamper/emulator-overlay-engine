# Copy this file to .env.bizhawk.local and replace the fake paths with local values.
# Never commit the local file, ROMs, save data, savestates, BIOS files, emulator
# binaries, or credentials.

EOE_BIZHAWK_EXE=C:\path\to\BizHawk-2.11.1\EmuHawk.exe
EOE_BIZHAWK_EMERALD_ROM=C:\path\to\Pokemon Emerald (USA, Europe).gba

# Optional. BizHawk loads this automatically through --load-state.
EOE_BIZHAWK_EMERALD_SAVESTATE=

# Relative paths resolve from the repository root. Absolute local paths also work.
EMERALD_SOURCE_SNAPSHOT_PATH=var\snapshots\emerald-us-rev0.bizhawk.source.json
EOE_LIVE_STATE_PATH=public\live-state.json

# Optional local tuning.
EMERALD_MAPPING_POLL_INTERVAL_MS=250
PORT=5173
